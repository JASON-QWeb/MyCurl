{
  "$schema": "../node_modules/@tauri-apps/cli/config.schema.json",
  "productName": "MyCurl",
  "version": "0.1.0",
  "identifier": "app.mycurl.desktop",
  "build": {
    "beforeDevCommand": "npm run dev",
    "devUrl": "http://localhost:5898",
    "beforeBuildCommand": "npm run build",
    "frontendDist": "../dist"
  },
  "app": {
    "windows": [
      {
        "label": "main",
        "title": "MyCurl",
        "width": 1360,
        "height": 860,
        "minWidth": 960,
        "minHeight": 600,
        "resizable": true,
        "center": true,
        "zoomHotkeysEnabled": true,
        "titleBarStyle": "Overlay",
        "hiddenTitle": true
      }
    ],
    "security": {
      "csp": null
    }
  },
  "bundle": {
    "active": true,
    "targets": "all",
    "category": "DeveloperTool",
    "shortDescription": "本地优先的 API 调试与 cURL 归档工具",
    "longDescription": "MyCurl 是一款本地优先的 API 调试客户端，支持一键粘贴 cURL 命令并自动收纳密钥、路由、请求体与 jq 响应筛选。",
    "icon": [
      "icons/32x32.png",
      "icons/128x128.png",
      "icons/128x128@2x.png",
      "icons/icon.icns",
      "icons/icon.ico"
    ],
    "macOS": {
      "minimumSystemVersion": "11.0",
      "dmg": {
        "appPosition": { "x": 180, "y": 170 },
        "applicationFolderPosition": { "x": 480, "y": 170 },
        "windowSize": { "width": 660, "height": 400 }
      }
    }
  }
}
