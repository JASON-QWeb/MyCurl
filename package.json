{
  "name": "mycurl",
  "productName": "MyCurl",
  "version": "0.1.0",
  "description": "粘贴 AI 给的 curl 直接存成接口库，自动收好 API Key，数据只存本地。Paste curl commands into a local-first API client with auto-extracted keys.",
  "private": true,
  "type": "module",
  "scripts": {
    "dev": "vite",
    "build": "vite build",
    "start": "node server/index.mjs --open",
    "serve": "node server/index.mjs",
    "test": "vitest run",
    "typecheck": "tsc --noEmit",
    "rust:test": "cargo test --manifest-path src-tauri/Cargo.toml",
    "rust:check": "cargo check --manifest-path src-tauri/Cargo.toml",
    "tauri": "tauri",
    "tauri:dev": "tauri dev",
    "tauri:build": "tauri build",
    "tauri:build:mac": "tauri build --bundles app,dmg",
    "tauri:build:universal": "tauri build --target universal-apple-darwin --bundles app,dmg"
  },
  "dependencies": {
    "@tauri-apps/api": "^2.2.0",
    "undici": "^7.0.0"
  },
  "devDependencies": {
    "@tauri-apps/cli": "^2.2.0",
    "@codemirror/autocomplete": "^6.18.0",
    "@codemirror/commands": "^6.7.0",
    "@codemirror/lang-javascript": "^6.2.2",
    "@codemirror/lang-json": "^6.0.1",
    "@codemirror/lang-xml": "^6.1.0",
    "@codemirror/lang-html": "^6.4.9",
    "@codemirror/language": "^6.10.0",
    "@codemirror/search": "^6.5.0",
    "@codemirror/state": "^6.4.1",
    "@codemirror/view": "^6.34.0",
    "@lezer/highlight": "^1.2.1",
    "@types/node": "^22.0.0",
    "@types/react": "^18.3.0",
    "@types/react-dom": "^18.3.0",
    "@vitejs/plugin-react": "^4.3.0",
    "react": "^18.3.1",
    "react-dom": "^18.3.1",
    "typescript": "^5.6.0",
    "vite": "^5.4.0",
    "vitest": "^2.1.0",
    "zustand": "^5.0.0"
  }
}
